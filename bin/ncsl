#! /usr/bin/env bash

CC=gcc
CFLAGS="-E -fpreprocessed -P -xc++"
ME=`basename $0`

# See if gcc supports the options we need.
echo 'int main(){}' | $CC $CFLAGS - >/dev/null 2>&1 || {
  echo "$ME: $CC doesn't support all of -E, -fpreprocessed, and -P options" >&2
  exit 2
}

find . -name '*.c' -o -name '*.cpp' -o -name '*.h' | xargs cat |
  $CC $CFLAGS - 2>/dev/null | wc -l

# vim:set et sw=2 ts=2:
